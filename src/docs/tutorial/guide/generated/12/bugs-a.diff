@@ -0,0 +1,22 @@
+import { describe, expect, test } from 'vitest'
+
+import { SEED } from '../src/domain'
+import { savedViewOf } from '../src/features/views'
+
+describe('Active bugs', () => {
+  test('lists open Bug issues in Todo, In Progress or In Review', () => {
+    const bugs = savedViewOf('bugs')
+    expect(bugs?.label).toBe('Active bugs')
+    const matched = SEED.filter(issue => bugs?.matches(issue) ?? false).map(issue => issue.id)
+    expect(matched).toEqual(['CRE-142', 'CRE-136'])
+  })
+
+  test('leaves out Backlog and Done bugs and issues without the label', () => {
+    const bugs = savedViewOf('bugs')
+    const base = SEED[0]
+    expect(bugs?.matches({ ...base, status: 'backlog' })).toBe(false)
+    expect(bugs?.matches({ ...base, status: 'done' })).toBe(false)
+    expect(bugs?.matches({ ...base, labels: ['Feature'] })).toBe(false)
+    expect(bugs?.matches({ ...base, status: 'todo' })).toBe(true)
+  })
+})
