@@ -193,3 +194,18 @@ describe('validateTitle', () => {
     ['x'.repeat(201), false],
   ])('%j is valid: %s', (title, valid) => expect(validateTitle(title).ok).toBe(valid))
 })
+
+describe('Active bugs', () => {
+  test('lists the issues labelled Bug in Todo, In Progress or In Review', () => {
+    const activeBugs = savedViewOf('active-bugs')
+    const base = SEED[0]!
+    const bug = (status: Issue['status']): Issue => ({ ...base, status, labels: ['Bug'] })
+    expect(SEED.filter(each => activeBugs?.matches(each) === true).map(each => each.id)).toEqual(['CRE-142', 'CRE-136'])
+    expect(activeBugs?.matches(bug('todo'))).toBe(true)
+    expect(activeBugs?.matches(bug('in_progress'))).toBe(true)
+    expect(activeBugs?.matches(bug('in_review'))).toBe(true)
+    expect(activeBugs?.matches(bug('backlog'))).toBe(false)
+    expect(activeBugs?.matches(bug('done'))).toBe(false)
+    expect(activeBugs?.matches({ ...base, status: 'todo', labels: ['Feature'] })).toBe(false)
+  })
+})
