{
  "name": "creaseui-effect-ui-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:stylex": "vite --host 127.0.0.1 --mode stylex",
    "dev:pleat": "vite --host 127.0.0.1 --mode pleat",
    "build": "tsc --noEmit && vite build && vite build --mode stylex && vite build --mode pleat",
    "test": "node --import tsx --test test/*.test.ts",
    "registry:build": "npx --yes shadcn@latest build registry.json --cwd .. --output effect-ui/.registry"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@4d6d7ec",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@4d6d7ec",
    "@pleat/core": "file:../packages/pleat-core",
    "@stylexjs/stylex": "^0.19.2",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@stylexjs/unplugin": "^0.19.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.2.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unplugin": "^2.3.11",
    "vite": "^8.3.6"
  }
}
