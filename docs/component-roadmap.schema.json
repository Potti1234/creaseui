{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verifiedAgainst", "documentation", "classifications", "qualityContract", "fidelity", "intentionalDifferences", "missing"],
  "properties": {
    "verifiedAgainst": {
      "type": "object",
      "required": ["repository", "commit", "date"]
    },
    "documentation": {
      "type": "object",
      "required": ["complete", "next"],
      "properties": {
        "complete": { "type": "array", "items": { "type": "string" } },
        "next": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classifications": {
      "type": "object",
      "required": ["full", "adapted", "recipe", "legacy"]
    },
    "qualityContract": {
      "type": "object",
      "required": ["statuses", "dimensions", "defaults", "classificationOverrides", "componentOverrides", "evidence"]
    },
    "fidelity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "priority", "gap"]
      }
    },
    "intentionalDifferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "reason"]
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "priority", "strategy"]
      }
    }
  }
}
