{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["documentation", "fidelity", "missing"],
  "properties": {
    "documentation": {
      "type": "object",
      "required": ["complete", "next"],
      "properties": {
        "complete": { "type": "array", "items": { "type": "string" } },
        "next": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fidelity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "priority", "gap"]
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "priority", "strategy"]
      }
    }
  }
}
