{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./docs-index.schema.json",
  "type": "object",
  "required": ["generatedFrom", "componentCount", "components"],
  "properties": {
    "generatedFrom": { "type": "array", "items": { "type": "string" } },
    "componentCount": { "type": "integer", "minimum": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "description", "docs", "source", "install", "dependencies", "examples", "api"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "docs": { "type": "string" },
          "source": { "type": "string" },
          "install": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "api": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "kind", "signature"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" },
                "signature": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
