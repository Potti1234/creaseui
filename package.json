{
  "name": "creaseui",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "A shadcn/ui-inspired component library for Foldkit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Potti1234/creaseui.git"
  },
  "bugs": {
    "url": "https://github.com/Potti1234/creaseui/issues"
  },
  "homepage": "https://creaseui.com",
  "bin": {
    "crease": "scripts/crease.mjs"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:staged": "lint-staged --max-arg-length 4000",
    "dev": "vite",
    "build": "npm run build:tailwind && npm run build:stylex",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:lint-package && npm run test:unit && npm run test:scene",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=8192' node --test --import tsx --import ./test/setup.ts test/*.test.ts",
    "test:scene": "vitest run",
    "test:e2e": "playwright test",
    "test:browser": "npm run build && playwright test",
    "check": "npm run format:check && npm run docs:encoding && npm run docs:metadata && npm run icons:adapters && npm run parity:check && npm run lint:composition && npm run lint:stylex-templates && npm run lint:stylex-contracts && npm run lint:stylex-governance && npm run stylex:adoption && npm run lint && npm run lint:design-system && npm run typecheck && npm test && npm run build",
    "check:full": "npm run check && npm run parity:upstream && npm run test:registry && npm run test:e2e",
    "docs:encoding": "node scripts/normalize-doc-encoding.mjs",
    "docs:encoding:fix": "node scripts/normalize-doc-encoding.mjs --write",
    "docs:metadata": "node scripts/generate-doc-metadata.mjs",
    "docs:metadata:generate": "node scripts/generate-doc-metadata.mjs --write",
    "parity:check": "node scripts/generate-parity-contract.mjs",
    "parity:generate": "node scripts/generate-parity-contract.mjs --write",
    "parity:upstream": "node scripts/sync-upstream-parity.mjs",
    "parity:upstream:update": "node scripts/sync-upstream-parity.mjs --update",
    "preset:build": "tsx scripts/materialize-create-preset.ts",
    "lint": "eslint src test scene e2e scripts packages/lint playwright.config.ts playwright.sites.config.ts vite.config.ts --quiet",
    "lint:design-system": "eslint src/ui src/stylex src/demo src/docs/components/pages --max-warnings 373",
    "test:lint-package": "node --test packages/lint/test/*.test.js",
    "lint:composition": "oxlint src/demo/board-constrained.ts src/demo/blocks-stylex src/stylex/composition && node scripts/check-constrained-composition.mjs && node --test --import tsx --import ./test/setup.ts test/stylex-composition.test.ts test/stylex-blocks-composition.test.ts",
    "lint:stylex-templates": "node scripts/check-stylex-template-system.mjs && node --test --import tsx --import ./test/setup.ts test/stylex-template-system.test.ts",
    "lint:stylex-contracts": "node scripts/check-stylex-contract-flow.mjs",
    "lint:stylex-governance": "node scripts/check-stylex-governance.mjs",
    "stylex:adoption": "node scripts/report-stylex-adoption.mjs",
    "stylex:adoption:generate": "node scripts/report-stylex-adoption.mjs --write",
    "icons:generate": "node scripts/generate-icon-nodes.mjs",
    "icons:adapters": "node scripts/generate-icon-adapters.mjs",
    "icons:adapters:generate": "node scripts/generate-icon-adapters.mjs --write",
    "registry:build": "npx --yes shadcn@latest build registry.json --output .registry",
    "registry:generate": "node scripts/generate-ui-registry.mjs",
    "registry:install-local": "node scripts/install-local-registry.mjs",
    "test:registry": "node scripts/verify-registry-install.mjs",
    "parity:names": "node scripts/check-upstream-parity.mjs",
    "component:create": "node scripts/create-component.mjs",
    "dev:tailwind": "vite --mode tailwind",
    "dev:stylex": "vite --mode stylex",
    "build:tailwind": "vite build --mode tailwind",
    "build:stylex": "vite build --mode stylex",
    "preview:tailwind": "vite preview --mode tailwind",
    "preview:stylex": "vite preview --mode stylex",
    "test:sites": "npm run build && playwright test --config playwright.sites.config.ts"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.117",
    "@foldkit/devtools": "0.164.0",
    "@foldkit/ui": "0.164.0",
    "@pierre/diffs": "^1.4.2",
    "@stylexjs/stylex": "^0.19.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/table-core": "8.21.3",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "effect": "4.0.0-rc.117",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "foldkit": "0.164.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@creaseui/lint": "file:packages/lint",
    "@foldkit/vite-plugin": "0.25.0",
    "@iconify-json/hugeicons": "^1.2.32",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@playwright/test": "^1.62.1",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "eslint": "^10.8.0",
    "fast-xml-parser": "^5.10.1",
    "happy-dom": "^20.11.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lucide-static": "^0.577.0",
    "oxfmt": "0.71.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin": "^2.3.11",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
